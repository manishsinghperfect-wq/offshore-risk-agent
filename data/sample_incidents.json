    @classmethod
    def get_sources_for_operation(cls, operation_type: str) -> List[Dict[str, str]]:
        return cls.SOURCE_MAP.get(operation_type, [])

    @classmethod
    def get_all_sources(cls) -> List[Dict[str, str]]:
        all_sources: List[Dict[str, str]] = []
        for _, values in cls.SOURCE_MAP.items():
            for source in values:
                if source not in all_sources:
                    all_sources.append(source)
        return all_sources
